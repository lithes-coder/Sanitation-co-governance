# ──────────────────────────────────────────────
#  LLM Provider configuration
#  Used by llm_utils.get_llm() across all labs.
# ──────────────────────────────────────────────

# Which provider to use: "anthropic", "openai", or "ollama"
LLM_PROVIDER=ollama

# Model to use — each provider has its own default if this is left commented out
LLM_MODEL=gemma4:e4b

# ── Ollama (local, no API key required) ───────
# Ollama must be running: https://ollama.com
# Pull the model first:  ollama pull gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434

# ── Anthropic ─────────────────────────────────
# Uncomment and fill in to switch to Anthropic:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-sonnet-4-5-20250929

# ── OpenAI ────────────────────────────────────
# Uncomment and fill in to switch to OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2-your-key-here
LANGCHAIN_PROJECT=agentic-ai-workshop-lab3