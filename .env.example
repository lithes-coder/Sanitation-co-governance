# Environment configuration — copy to .env and fill in
# (only DATABASE_URL is required to run; everything else has a working default)

# SQLite database (Prisma)
DATABASE_URL="file:./dev.db"

# Session signing secret — CHANGE THIS in production (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: real Chennai Corporation webhook (mock gateway used when unset)
# AUTHORITY_WEBHOOK_URL="https://gcc.example.gov.in/webhooks/complaints"
# AUTHORITY_WEBHOOK_SECRET="your-webhook-secret"

# Optional: Python agentic AI assistant (FastAPI service)
# FASTAPI_URL="http://127.0.0.1:8000"
